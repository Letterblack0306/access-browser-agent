# Normalize source/text to LF so future diffs do not become whole-file CRLF/LF churn.
* text=auto
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.exe filter=lfs diff=lfs merge=lfs -text
